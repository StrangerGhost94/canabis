# PostgreSQL connection string
DATABASE_URL="postgresql://cairn:password@localhost:5432/cairn"
# 32+ random characters. Generate: openssl rand -base64 48
SESSION_SECRET=""
# Salt for pseudonymising IPs and visitor ids. Generate: openssl rand -base64 24
HASH_SALT=""
APP_URL="http://localhost:3000"
# "true" seeds fictional data, enables simulated licence checks and shows the demo banner.
# Must be "false" in production.
DEMO_MODE="true"
UPLOAD_DIR="./storage/uploads"
# Required by POST /api/cron/licences (daily licence expiry sweep)
CRON_SECRET=""
# Real mode: the account that signs up with this email becomes the platform administrator.
ADMIN_EMAIL=""
